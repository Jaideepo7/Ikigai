{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ikigai",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "ikigai", "database_id": "REPLACE_WITH_ID_FROM_wrangler_d1_create", "migrations_dir": "migrations" }
  ],
  "durable_objects": { "bindings": [{ "name": "GARDEN", "class_name": "GardenRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GardenRoom"] }],
  "observability": { "enabled": true }
}
