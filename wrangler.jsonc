{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ikigai",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*",
			"/ws/*"
		],
		"not_found_handling": "single-page-application"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ikigai",
			"database_id": "6f13ffad-2259-4817-a256-b773c8522bc7",
			"migrations_dir": "migrations"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "GARDEN",
				"class_name": "GardenRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"GardenRoom"
			]
		}
	],
	"observability": {
		"enabled": true
	}
}